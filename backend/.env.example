# Salin ke .env lalu isi nilai asli. Jangan pernah commit .env.
PORT=8080
# SUPABASE_URL di bawah juga dipakai frontend (dibaca vite.config.ts), jadi
# cukup didefinisikan sekali di sini.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Opsional. Bila kosong, token diverifikasi ke Supabase Auth memakai service role key.
# Bila diisi, gunakan JWT Secret (HS256) dari Dashboard > Project Settings > API.
SUPABASE_JWT_SECRET=
APP_ORIGIN=*
TZ=Asia/Jakarta
DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Opsional
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
